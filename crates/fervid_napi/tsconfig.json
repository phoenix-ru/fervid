{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["__tests__/**/*.ts", "benchmark/**/*.mts", "vitest.config.ts"],
  "exclude": ["node_modules", "artifacts", "npm", "coverage"]
}
